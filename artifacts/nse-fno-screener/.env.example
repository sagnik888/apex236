# Optional but recommended for exchange-real-time prices.
# Create a read-only Analytics Token in Upstox and paste it ONLY into your local .env.
UPSTOX_ANALYTICS_TOKEN=
USE_UPSTOX_LIVE=false

# Live-market scheduler: one bulk quote pulse + independent scan lanes.
# 237 symbols fit inside a single Upstox Full Market Quote request (limit: 500).
QUOTE_REFRESH_SECONDS=15
MICRO_SCAN_SECONDS=55
MEDIUM_SCAN_SECONDS=120
MACRO_SCAN_SECONDS=300

# Closed-market resource saving. Startup still warms every lane once.
CLOSED_QUOTE_REFRESH_SECONDS=180
CLOSED_MICRO_SCAN_SECONDS=300
CLOSED_MEDIUM_SCAN_SECONDS=600
CLOSED_MACRO_SCAN_SECONDS=900
MANUAL_REFRESH_COOLDOWN_SECONDS=12

INSTRUMENTS_PATH=data/instruments.json
TOP_ROWS=237
